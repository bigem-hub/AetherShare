# AetherShare Configuration
# Copy this file to .env.local and configure your values

# ===========================================
# NEXT.JS PUBLIC VARIABLES (accessible to browser)
# ===========================================

# Choose signaling provider: "websocket" (default) or "supabase"
NEXT_PUBLIC_SIGNALING_PROVIDER=websocket

# WebSocket signaling server (only used when SIGNALING_PROVIDER=websocket)
# For Railway/Render VPS deployment: ws://your-signaling-server.up.railway.app:8080
# For local development: ws://localhost:8080
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# Supabase Realtime signaling (only used when SIGNALING_PROVIDER=supabase)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://arldauqfauldqbofmmeo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ViGVfpGPvWARDzE_VC7-pQ_gdghCsbE

# Room expiration time in milliseconds (default: 30 minutes)
NEXT_PUBLIC_ROOM_EXPIRATION=1800000

# ===========================================
# SERVER-ONLY VARIABLES (never expose these)
# ===========================================

# WebSocket server port (only used when SIGNALING_PROVIDER=websocket)
SIGNALING_PORT=8080

# STUN servers for WebRTC (comma-separated URLs)
# These are public STUN servers - TURN servers require credentials
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional TURN server configuration (for NAT traversal)
# TURN_SERVERS=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# Allowed origins for WebSocket connections (comma-separated)
# Use "*" for development, be specific in production
ALLOWED_ORIGINS=*,http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
# Maximum rooms a single IP can create per minute
RATE_LIMIT_CREATE=10

# Maximum joins a single IP can attempt per minute
RATE_LIMIT_JOIN=30

# Room settings
ROOM_EXPIRATION_MS=1800000
MAX_PEERS_PER_ROOM=2